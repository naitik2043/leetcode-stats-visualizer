# Required for account registration, login, sessions, and saved profiles
MONGODB_URI=
JWT_SECRET=

# Required for password-reset emails
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=https://leetmetric-sooty.vercel.app

# Optional: open the separate Paste Vault from the signed-in dashboard
PASTE_APP_URL=https://paste-app-wine.vercel.app

# Optional: shared distributed API rate limiting for serverless instances
# Create an Upstash Redis database and copy its REST URL and standard token.
# Keep the token server-side; never place it in frontend code.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
